# Copy to .env.local. npm run db:local creates local DB and random secrets.
DATABASE_URL=postgresql://USER:PASSWORD@127.0.0.1:55432/miron
# Optional separate server password; overrides a password in DATABASE_URL.
DATABASE_PASSWORD=
BETTER_AUTH_SECRET=REPLACE_WITH_AT_LEAST_32_RANDOM_CHARACTERS
BETTER_AUTH_URL=http://localhost:3000
# Set false for the current Yandex-first test. Mail/password support can be enabled later.
AUTH_EMAIL_PASSWORD_ENABLED=false
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
SMTP_FROM=MIRON <hello@miron.local>
# Production SMTP credentials only on server
SMTP_USER=
SMTP_PASSWORD=
YANDEX_CLIENT_ID=
YANDEX_CLIENT_SECRET=
VK_CLIENT_ID=
VK_CLIENT_SECRET=
ENABLE_DEMO_WORKOUTS=true
# Beta chat: server-only PlusVibe Qwen route, never NEXT_PUBLIC keys.
ENABLE_AI_ASSISTANT=false
PLUSVIBE_API_KEY=
AI_DAILY_INTENT_LIMIT=200
# Explicit beta catalog bootstrap; all editorial rows retain draft status.
APP_RELEASE_CHANNEL=beta
SEED_BETA_CATALOG=false
DB_POOL_MAX=5
# Trusted reverse proxy only; production auth origin must use HTTPS.
AUTH_TRUST_PROXY=false

# Only the scoped public-illustrations bucket. Never place account uploads here.
MIRON_MEDIA_ORIGIN=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# One-time upload on beta bootstrap; remove flag and write credentials afterwards.
UPLOAD_PUBLIC_MEDIA=false

# Voice: server-only Groq + preloaded local Whisper. No NEXT_PUBLIC secrets.
GROQ_API_KEY=
GROQ_TRANSCRIPTION_MODEL=whisper-large-v3
VOICE_WORKER_SECRET=REPLACE_WITH_AT_LEAST_32_RANDOM_CHARACTERS
VOICE_WORKER_URL=http://127.0.0.1:3075
VOICE_WORKER_PORT=3075
VOICE_LOCAL_MODEL=small
VOICE_LOCAL_MODEL_CACHE=.local/voice/models
VOICE_LOCAL_MODEL_LABEL=whisper-small-int8
VOICE_CPU_THREADS=4
# Only enables local dev prototype /story voice; ignored in production.
ENABLE_VOICE_PREVIEW=false
